# Load the shared POSIX environment first so zsh and non-zsh shells
# keep the same baseline variables and PATH.
: "${XDG_CONFIG_HOME:=$HOME/.config}"
if [ -r "$XDG_CONFIG_HOME/sh/env" ]; then
  . "$XDG_CONFIG_HOME/sh/env"
fi

# Direct zsh configuration directory
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
