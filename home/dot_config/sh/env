# Shared POSIX shell environment.
# Keep shell-agnostic variables here so login and non-interactive shells
# can reuse the same baseline.

# Locale
: "${LANG:=en_US.UTF-8}"
: "${LC_CTYPE:=${LANG}}"
export LANG LC_CTYPE

# XDG Base Directories
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_DATA_DIRS:=/usr/local/share:/usr/share}"
: "${XDG_CONFIG_DIRS:=/etc/xdg}"
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME
export XDG_DATA_DIRS XDG_CONFIG_DIRS

path_prepend() {
  [ -n "${1:-}" ] || return 0
  [ -d "$1" ] || return 0
  case ":${PATH:-}:" in
    *:"$1":*) ;;
    *)
      if [ -n "${PATH:-}" ]; then
        PATH=$1:$PATH
      else
        PATH=$1
      fi
      ;;
  esac
}

manpath_prepend() {
  [ -n "${1:-}" ] || return 0
  [ -d "$1" ] || return 0
  case ":${MANPATH:-}:" in
    *:"$1":*) ;;
    *)
      if [ -n "${MANPATH:-}" ]; then
        MANPATH=$1:$MANPATH
      else
        MANPATH=$1
      fi
      ;;
  esac
}

find_brew_bin() {
  for brew_bin in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew
  do
    if [ -x "$brew_bin" ]; then
      printf '%s\n' "$brew_bin"
      return 0
    fi
  done

  if command -v brew >/dev/null 2>&1; then
    command -v brew
    return 0
  fi

  return 1
}

# Minimal Homebrew bootstrap for shared environments.
BREW_BIN=
if BREW_BIN=$(find_brew_bin 2>/dev/null); then
  eval "$("$BREW_BIN" shellenv)"
fi
unset BREW_BIN

# Tool-specific environment variables (XDG-aware)
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/rg/config"

export NODE_PATH="$XDG_DATA_HOME/node/lib"
export NODE_REPL_HISTORY="$XDG_DATA_HOME/node/repl_history"
export NO_UPDATE_NOTIFIER=1
export NVM_DIR="$XDG_DATA_HOME/nvm"

export npm_config_userconfig="$XDG_CONFIG_HOME/npm/config"
export npm_config_cache="$XDG_CACHE_HOME/npm"
export npm_config_prefix="$XDG_DATA_HOME/npm"
export npm_config_init_module="$XDG_DATA_HOME/npm/config/npm-init.js"
export NPM_CONFIG_PREFIX="$npm_config_prefix"

export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"

export MYSQL_HISTFILE="$XDG_DATA_HOME/mysql/history"
export SQLITE_HISTORY="$XDG_DATA_HOME/sqlite/history"
export PSQL_HISTORY="$XDG_DATA_HOME/psql/history"
export PGCLIRC="$XDG_CONFIG_HOME/pgcli/config"
export MONGO_HISTFILE="$XDG_DATA_HOME/mongo/history"

export PAGER="${PAGER:-less}"
export LESS='-F -g -i -M -R -S -w -X -z-4 -j4'
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export CLICOLOR=1

export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"

# PATH consolidation
path_prepend "$HOME/.nodebrew/current/bin"
path_prepend "$XDG_DATA_HOME/bundle/bin"
path_prepend "$XDG_DATA_HOME/cargo/bin"
path_prepend "$XDG_DATA_HOME/npm/bin"
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
path_prepend "/usr/local/sbin"
path_prepend "/usr/local/bin"

if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX=$(brew --prefix 2>/dev/null || true)
  if [ -n "$BREW_PREFIX" ]; then
    path_prepend "$BREW_PREFIX/opt/openssl/bin"
    path_prepend "$BREW_PREFIX/opt/openssl@3/bin"
    path_prepend "$BREW_PREFIX/opt/coreutils/libexec/gnubin"
    path_prepend "$BREW_PREFIX/opt/mysql-client/bin"
    manpath_prepend "$BREW_PREFIX/opt/coreutils/libexec/gnuman"
  fi
  unset BREW_PREFIX
fi

export PATH
[ -n "${MANPATH:-}" ] && export MANPATH

unset -f path_prepend
unset -f manpath_prepend
unset -f find_brew_bin
